# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution and project files first for layer caching
COPY LookUp.Core.sln ./
COPY LookUp/LookUp.csproj LookUp/
COPY LookUp.Core/LookUp.Scanner.csproj LookUp.Core/
COPY LookUp.Website/LookUp.Website.csproj LookUp.Website/
COPY LookUp.Tests/LookUp.Tests.csproj LookUp.Tests/

# Restore dependencies
RUN dotnet restore LookUp.Core.sln

# Copy the rest of the source
COPY LookUp/ LookUp/
COPY LookUp.Core/ LookUp.Core/

# Publish the Scanner/Core project
RUN dotnet publish LookUp.Core/LookUp.Scanner.csproj -c Release -o /app/publish --no-restore

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Create the lookup group and user with the same uid/gid as the host
RUN groupadd --gid 1002 lookup && \
    useradd --uid 1002 --gid 1002 --no-create-home --shell /bin/false lookup

# Set HOME so EnvironmentHelpers.GetDataDir() resolves correctly
ENV HOME=/home/lookup

# Copy published output from build stage
COPY --from=build /app/publish ./

USER lookup

EXPOSE 37127

ENTRYPOINT ["dotnet", "LookUp.Scanner.dll"]
