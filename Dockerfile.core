# syntax=docker/dockerfile:1
# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution and project files first for layer caching
COPY LookUp/LookUp.csproj LookUp/
COPY LookUp.Core/LookUp.Scanner.csproj LookUp.Core/

RUN --mount=type=cache,target=/root/.nuget/packages \
	dotnet restore LookUp.Core/LookUp.Scanner.csproj

# Copy the rest of the source
COPY LookUp/ LookUp/
COPY LookUp.Core/ LookUp.Core/

# Publish the Scanner/Core project
RUN --mount=type=cache,target=/root/.nuget/packages \ 
	dotnet publish LookUp.Core/LookUp.Scanner.csproj -c Release -o /app/publish --no-restore

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# Get curl for health checks
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* 

# Create the lookup group and user with the same uid/gid as the host
RUN groupadd --gid 1002 lookup && \
    useradd --uid 1002 --gid 1002 --no-create-home --shell /bin/false lookup

# Set HOME so EnvironmentHelpers.GetDataDir() resolves correctly
ENV HOME=/home/lookup
# Override default .NET port (8080) to listen on
ENV ASPNETCORE_URLS=http://+:37127

# Copy published output from build stage
COPY --from=build --chown=lookup:lookup /app/publish ./

USER lookup

EXPOSE 37127

ENTRYPOINT ["dotnet", "LookUp.Scanner.dll"]
