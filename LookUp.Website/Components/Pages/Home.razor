@page "/"
@inject HttpClient HttpClient

<h3>LookUp Data</h3>

@if (data == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <pre>@data</pre>
}

@code {
    private string? data;

    protected override async Task OnInitializedAsync()
    {
        await FetchData();
    }

    private async Task FetchData()
    {
        try
        {
            data = await HttpClient.GetStringAsync("https://localhost:37127/test");
        }
        catch (Exception ex)
        {
            data = $"Error: {ex.Message}";
        }
        StateHasChanged();
    }
}