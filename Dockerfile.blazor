# syntax=docker/dockerfile:1
# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY LookUp/LookUp.csproj LookUp/
COPY LookUp.Website/LookUp.Website.csproj LookUp.Website/

RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet restore LookUp.Website/LookUp.Website.csproj

COPY LookUp/ LookUp/
COPY LookUp.Website/ LookUp.Website/

RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet publish LookUp.Website/LookUp.Website.csproj -c Release -o /app/publish --no-restore

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

RUN groupadd --gid 1002 lookup && \
    useradd --uid 1002 --gid 1002 --no-create-home --shell /bin/false lookup

ENV HOME=/home/lookup
# Override default port to listen on
ENV ASPNETCORE_URLS=http://+:5000

COPY --from=build --chown=lookup:lookup /app/publish ./

USER lookup

EXPOSE 5000
ENTRYPOINT ["dotnet", "LookUp.Website.dll"]