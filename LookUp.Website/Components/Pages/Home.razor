@page "/"

<div class="home-container">
    <h1>Look Up - Blockchain Message Explorer</h1>

    <div class="cards-container">
        @foreach (var message in messages)
        {
            <div class="message-card">
                <div class="card-header">
                    <h3>Transaction Details</h3>
                </div>
                <div class="card-body">
                    <div class="card-row">
                        <label>Transaction ID:</label>
                        <span class="value">@message.TransactionID</span>
                    </div>
                    <div class="card-row">
                        <label>Message:</label>
                        <span class="value">@message.Message</span>
                    </div>
                    <div class="card-row">
                        <label>Hex:</label>
                        <span class="value">@message.Hex</span>
                    </div>
                    <div class="card-row">
                        <label>Block Hash:</label>
                        <span class="value">@message.BlockHash</span>
                    </div>
                    <div class="card-row">
                        <label>Block Mined At:</label>
                        <span class="value">@message.BlockMinedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .home-container {
        background-color: #121212;
        color: #e0e0e0;
        min-height: 100vh;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .home-container h1 {
            text-align: center;
            margin-bottom: 40px;
            color: #ffffff;
            font-size: 2.5rem;
            text-shadow: 0 0 10px rgba(0, 122, 204, 0.5);
        }

    .cards-container {
        display: flex;
        justify-content: center;
        gap: 25px;
        flex-wrap: wrap;
        max-width: 1400px;
        margin: 0 auto;
    }

    .message-card {
        background-color: #1e1e1e;
        border: 1px solid #333;
        border-radius: 8px;
        width: 350px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .message-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.4);
            border-color: #007acc;
        }

    .card-header {
        background-color: #252526;
        padding: 15px;
        border-bottom: 1px solid #333;
        border-radius: 8px 8px 0 0;
    }

        .card-header h3 {
            margin: 0;
            color: #007acc;
            font-size: 1.2rem;
        }

    .card-body {
        padding: 20px;
    }

    .card-row {
        margin-bottom: 15px;
        display: flex;
        flex-direction: column;
    }

        .card-row label {
            font-weight: bold;
            color: #007acc;
            margin-bottom: 5px;
            font-size: 0.9rem;
        }

    .value {
        word-break: break-all;
        padding: 8px;
        background-color: #2d2d30;
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.9rem;
        color: #dcdcdc;
    }

    @@media (max-width: 1200px) {
        .cards-container
        {
            flex-direction: column;
            align-items: center;
        }

        .message-card {
            width: 100%;
            max-width: 400px;
        }

    }
</style>

