<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Look Up – Search messages on the Bitcoin blockchain</title>
    <!-- Search engines and link previews: the site has one public page, so these describe it directly. -->
    <meta name="description" content="Search the human-readable messages people have left in Bitcoin transactions. Find notes by words, transaction ID, block hash or date. Free and open source." />
    <link rel="canonical" href="https://notesontheblockchain.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Look Up" />
    <meta property="og:title" content="Look Up – Search messages on the Bitcoin blockchain" />
    <meta property="og:description" content="Search the human-readable messages people have left in Bitcoin transactions. Find notes by words, transaction ID, block hash or date." />
    <meta property="og:url" content="https://notesontheblockchain.com/" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#181b29" />
    <script>
        // Text waits unrevealed until the decode animation starts (js/decode.js), so it doesn't flash first; never for more than 3 seconds.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'animate' in Element.prototype) {
            document.documentElement.classList.add('decode-intro');
            setTimeout(() => document.documentElement.classList.remove('decode-intro'), 3000);
        }
    </script>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="LookUp.Website.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode=RenderMode.InteractiveServer />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/decode.js"></script>
</body>

</html>
