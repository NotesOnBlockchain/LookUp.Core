@page "/search"
@inject HttpClient HttpClient
@inject WebsiteConfig Config

<div class="home-container">
    <h1>Find your message</h1>
    <div class="search-container">
        <div class="search-form">
            <input type="text"
                   @bind="searchBarContent"
                   placeholder="Search by TxID, Message, Date..."
                   class="search-input" />

            <button @onclick="SendSearchReq" class="search-button">
                Search
            </button>
        </div>

        <div class="cards-container">
            @if (searchResult.Count > 0)
            {
                @foreach (var message in searchResult)
                {
                    <div class="message-card">
                        <div class="card-header">
                            <h3>Transaction Details</h3>
                        </div>
                        <div class="card-body">
                            <div class="card-row">
                                <label>Transaction ID:</label>
                                <span class="value">@message.TransactionID</span>
                            </div>
                            <div class="card-row">
                                <label>Message:</label>
                                <span class="value">@message.Message</span>
                            </div>
                            <div class="card-row">
                                <label>Hex:</label>
                                <span class="value">@message.Hex</span>
                            </div>
                            <div class="card-row">
                                <label>Block Hash:</label>
                                <span class="value">@message.BlockHash</span>
                            </div>
                            <div class="card-row">
                                <label>Block Mined At:</label>
                                <span class="value">@message.BlockMinedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (searchResult.Count == 0 && isRequested)
            {
                <h3>No Results...</h3>
            }
            else
            {
                <!-- EMPTY FOR A REASON -->
            }
        </div>
    </div>
</div>

<style>
    .search-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .search-form {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .search-input {
        flex: 1;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 16px;
    }

    .search-button {
        padding: 10px 20px;
        background-color: #007acc;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 16px;
    }

        .search-button:hover {
            background-color: #005a9e;
        }

    .result-container {
        margin-top: 20px;
        padding: 15px;
        background-color: #f9f9f9;
        border-radius: 4px;
        border-left: 4px solid #007acc;
    }

        .result-container h3 {
            margin-top: 0;
            color: #333;
        }

    .error {
        color: #d32f2f;
        background-color: #ffebee;
        padding: 10px;
        border-radius: 4px;
        margin-top: 10px;
    }

    pre {
        white-space: pre-wrap;
        word-break: break-all;
        background-color: #f5f5f5;
        padding: 10px;
        border-radius: 4px;
        overflow-x: auto;
    }
</style>

@code {

    private string searchBarContent = string.Empty;
    private List<MessageModel> searchResult = new List<MessageModel>();
    private bool isRequested = false;

    private async Task SendSearchReq()
    {
        try
        {
            isRequested = true;
            var request = new HttpRequestMessage(HttpMethod.Get, $"{Config.BandendUri}/search?query={Uri.EscapeDataString(searchBarContent)}");
            request.Headers.Add("Authorization", $"ApiKey {Config.APIKey}");
            var response = await HttpClient!.SendAsync(request);
            
            searchResult = await response.Content.ReadFromJsonAsync<List<MessageModel>>();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }

        StateHasChanged();
    }
}
