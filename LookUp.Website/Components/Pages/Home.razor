@page "/"
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject WebsiteConfig Config

<!-- Landing page - search first, example messages below -->
<div class="home-container">
    <h1>Look Up - Blockchain Message Explorer</h1>

    <!-- Search -->
    <div class="search-section">
        <div class="search-container">
            <form class="search-form" @onsubmit="SendSearchReq">
                <label for="search-query" class="visually-hidden">Search messages</label>
                <input type="search"
                       id="search-query"
                       @bind="searchBarContent"
                       @bind:event="oninput"
                       maxlength="@Constants.Constants.MaxSearchQueryLength"
                       aria-describedby="@InputDescribedBy"
                       aria-invalid="@(ShowTooShort ? "true" : null)"
                       placeholder="TxID, block hash, hex, message or date"
                       autocomplete="off"
                       spellcheck="false"
                       enterkeyhint="search"
                       class="search-input" />

                <button type="submit" class="search-button" disabled="@isLoading">
                    Search
                </button>
            </form>
            @if (ShowTooShort)
            {
                <p id="search-too-short" class="search-inline-error">Type at least 3 characters to search.</p>
            }
            <p id="search-hint" class="search-hint">Paste a transaction ID, block hash or full hex, type words from the message, or enter a date as YYYY-MM-DD (UTC).</p>
        </div>

        <!-- Announces every search outcome to screen readers; the visible versions are below. -->
        <p class="visually-hidden" role="status">@StatusAnnouncement</p>

        @if (isRequested && !isTooFewChars)
        {
            <section class="results" aria-labelledby="results-title">
                <h2 id="results-title" class="results-title">@ResultsTitle</h2>

                @if (isLoading)
                {
                    <div class="loading-container">
                        <div class="spinner large"></div>
                    </div>
                }
                else if (searchError is not null)
                {
                    <div class="search-error" role="alert">
                        <p>@searchError</p>
                        <button type="button" class="search-button" @onclick="SendSearchReq">Try again</button>
                    </div>
                }
                else if (searchResult.Count > 0)
                {
                    @if (searchResult.Count >= Constants.Constants.MaxSearchResults)
                    {
                        <p class="search-note">Showing the @Constants.Constants.MaxSearchResults most recent matches. Use a more specific search to find older ones.</p>
                    }

                    <div class="cards-container">
                        @foreach (var message in searchResult)
                        {
                            <MessageCard Message="message" />
                        }
                    </div>
                }
                else
                {
                    <div class="search-empty">
                        <p>Nothing on the blockchain matches that search. You could try:</p>
                        <ul>
                            <li>one or two distinctive words from the message</li>
                            <li>the full 64-character transaction ID or block hash</li>
                            <li>the day it was mined, as YYYY-MM-DD (UTC)</li>
                        </ul>
                        <p>Some messages are filtered out as spam. <a href="/activefilters">See the filter rules</a>.</p>
                    </div>
                }
            </section>
        }
    </div>

    <!-- Example messages -->
    <div class="examples-section">
        <h2>Example messages</h2>
        <div class="cards-container">
            @foreach (var message in ExampleMessages)
            {
                <MessageCard Message="message" />
            }
        </div>
    </div>
</div>

<!-- About -->
<div class="home-container">
    <h2>About Look Up</h2>

    <p>It's a small project that scans the Bitcoin blockchain for human-readable messages in transactions.</p>
    <p>This page lets you find messages on the blockchain by transaction ID, block hash or full hex (exact match), by words in the message, or by the UTC date of the block.</p>

    <p>The blockchain is full of noise and alt coin contracts that we need to filter out. Check the full set of active filter rules <a href="/activefilters" class="github-link">here</a>.</p>

    <p style="font-family: sans-serif; font-size: 1.1rem;">
        Check out the source code
        <a href="https://github.com/NotesOnBlockchain/LookUp.Core" class="github-link" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle; margin-right: 4px;">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.66-3.795-1.455-3.795-1.455-.54-1.38-1.335-1.755-1.335-1.755-1.095-.75.09-.735.09-.735 1.2.09 1.83 1.245 1.83 1.245 1.08 1.86 2.805 1.32 3.495 1.005.105-.78.42-1.32.765-1.62-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405 1.02 0 2.04.135 3 .405 2.28-1.545 3.285-1.23 3.285-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.285 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>on GitHub here!
        </a>
    </p>

    <div class="disclaimer">
        <p>Disclaimer: Messages on the blockchain don't automatically become true or the truth. On important topics, please make your own research.</p>
        <p>Engraving the truth onto the blockchain is easy and simple. Engraving lies is just as easy and simple.</p>
    </div>

    <!-- Tech Stack -->
    <h2>Technology Stack</h2>
    <div class="tech-stack">
        <ul>
            <li>C#/.NET</li>
            <li>Entity Framework</li>
            <li>PostgreSQL</li>
            <li>Blazor</li>
            <li>HTML5/CSS3</li>
        </ul>
    </div>
</div>

<style>
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 40px;
        color: #a3a9b8;
    }

    .spinner {
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255, 255, 255, 0.15);
        border-top-color: #6cb4c9;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

        .spinner.large {
            width: 40px;
            height: 40px;
            border-width: 4px;
            border-top-color: #6cb4c9;
        }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .search-note {
        margin: 0 0 24px;
    }

    .search-hint {
        max-width: 600px;
        margin: 0 auto;
        font-size: 0.95rem;
    }

    .home-container .search-inline-error {
        max-width: 600px;
        margin: -12px auto 8px;
        color: #f0b4b4;
        font-size: 0.95rem;
    }

    /* Search outcome: a plain status heading, then the results, the error or the empty state. */
    .results {
        margin-top: 16px;
    }

    .home-container .results-title {
        margin: 0 0 16px;
        font-size: 1.5rem;
        color: #e6e6e6;
        text-shadow: none;
        overflow-wrap: anywhere;
    }

        .home-container .results-title::after {
            content: none;
        }

    .search-error {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px 24px;
        background: rgba(232, 120, 120, 0.12);
        border-radius: 8px;
        text-align: center;
    }

        .home-container .search-error p {
            margin: 0 0 16px;
            color: #f2c9c9;
        }

    .search-empty {
        max-width: 600px;
        margin: 0 auto;
        text-align: left;
    }

        .home-container .search-empty p {
            margin: 0 0 8px;
            text-align: left;
        }

        .search-empty ul {
            margin: 0 0 16px;
            padding-left: 1.25rem;
            color: #cfd3dc;
            font-size: 1.05rem;
        }

        .search-empty li {
            margin-bottom: 4px;
        }

        .search-empty a {
            color: #e6e6e6;
            text-underline-offset: 0.2em;
        }

    .search-button:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .search-container {
        margin: 0 auto;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .search-form {
        max-width: 600px;
        display: flex;
        gap: 10px;
        margin: 0 auto 20px auto;
    }

    /* Generous break after the search group, so the examples read as a separate, secondary section. */
    .examples-section {
        margin-top: 72px;
    }

    /* A dark field with a visible edge, so the button carries the action. */
    .search-input {
        flex: 1;
        padding: 10px;
        border: 1px solid #6b7290;
        border-radius: 4px;
        font-size: 16px;
        background-color: #10121b;
        color: #eceef4;
    }

        .search-input::placeholder {
            color: #9aa1b0;
        }

    .search-button {
        padding: 10px 20px;
        background-color: #6cb4c9;
        color: #0f1220;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 500;
    }

        .search-button:hover {
            background-color: #86c4d6;
        }

    .search-input:focus-visible,
    .search-button:focus-visible {
        outline: 2px solid #6cb4c9;
        outline-offset: 2px;
    }

    .result-container {
        margin-top: 20px;
        padding: 15px;
        background-color: #f9f9f9;
        border-radius: 4px;
        border-left: 4px solid #007acc;
    }

        .result-container h3 {
            margin-top: 0;
            color: #333;
        }

    .error {
        color: #d32f2f;
        background-color: #ffebee;
        padding: 10px;
        border-radius: 4px;
        margin-top: 10px;
    }

    pre {
        white-space: pre-wrap;
        word-break: break-all;
        background-color: #f5f5f5;
        padding: 10px;
        border-radius: 4px;
        overflow-x: auto;
    }

    .github-link {
        color: #e6e6e6;
        text-decoration: none;
        font-weight: bold;
        border-bottom: 1px solid #6cb4c9;
        transition: color 0.2s ease;
    }

        .github-link:hover {
            color: #ffffff;
            border-color: #86c4d6;
        }
</style>

@code {
    private List<MessageModel> ExampleMessages = new()
    {
        new MessageModel(
            new Guid(),
            "7818a451bbb68106901f3bf040532ebf457455e924b096707847a502506df1a5",
            "Merry Christmas Dad! We luv & appreciate u very much. 80 bytes isnt enuf - JSNVG",
            "4d65727279204368726973746d61732044616421205765206c75762026206170707265636961746520752076657279206d7563682e2038302062797465732069736e7420656e7566202d204a534e5647",
            "00000000000000000000a143a030c2f34a2e7ab16d6648217f4cfd9058d85c84",
            new(2025, 12, 25, 9, 40, 37, TimeSpan.FromHours(1))),
        new MessageModel(
            new Guid(),
            "6db8e6a866f2149b4ae6c5c884c7d6e3137b2599ddb84cc57f71e648ac3e1a95",
            "Christ is King.",
            "436872697374206973204b696e672e",
            "00000000000000000001d67aaee791a4a74214fc76973c60739395996d1996d7",
            new(2026, 1, 8, 18, 23, 17, TimeSpan.FromHours(1))),
        new MessageModel(
            new Guid(),
            "edf0dc50de7065ec2cfcb223091746bacce2ba2c139bcd3a748fdeb18e3741b3",
            "Thank you Satoshi. We love you <3",
            "5468616e6b20796f75205361746f7368692e205765206c6f766520796f75203c33",
            "0000000000000000000191855bc8648d1640addd3434846c4a8538ae8880422d",
            new(2025, 12, 18, 14, 50, 24, TimeSpan.FromHours(1))
        )
    };

    // Upper bound for a single search, including reading the response.
    private static readonly TimeSpan SearchTimeout = TimeSpan.FromSeconds(60);

    private const string SearchFailedMessage = "Search is unavailable right now. Please try again in a moment.";
    private const string SearchTimedOutMessage = "The search took too long. Please try again or use a more specific search.";

    // Long queries (a pasted hex string) are shortened where they are echoed back, so headings stay readable.
    private const int MaxEchoedQueryLength = 32;

    private string searchBarContent = string.Empty;
    private List<MessageModel> searchResult = new List<MessageModel>();
    private string? searchError;
    private string lastQuery = string.Empty;
    private bool isRequested = false;
    private bool isLoading = false;
    private bool isTooFewChars = false;

    private CancellationTokenSource? _cts;

    // The "too short" note disappears as soon as the visitor has typed enough.
    private bool ShowTooShort => isTooFewChars && searchBarContent.Trim().Length < 3;

    private string InputDescribedBy => ShowTooShort ? "search-too-short search-hint" : "search-hint";

    private string EchoedQuery => lastQuery.Length > MaxEchoedQueryLength ? lastQuery[..MaxEchoedQueryLength] + "…" : lastQuery;

    private string ResultsTitle =>
        isLoading ? $"Searching for “{EchoedQuery}”…"
        : searchError is not null ? "Search failed"
        : searchResult.Count == 0 ? $"No messages found for “{EchoedQuery}”"
        : searchResult.Count == 1 ? $"1 message found for “{EchoedQuery}”"
        : $"{searchResult.Count} messages found for “{EchoedQuery}”";

    // Errors are announced by their own alert, so the status region stays quiet for them.
    private string StatusAnnouncement =>
        ShowTooShort ? "Type at least 3 characters to search."
        : !isRequested || isTooFewChars || searchError is not null ? string.Empty
        : ResultsTitle;

    private async Task SendSearchReq()
    {
        // The button is disabled while loading, but Enter can still submit the form.
        if (isLoading)
            return;

        isRequested = true;
        searchError = null;
        searchResult = new List<MessageModel>();

        string query = searchBarContent.Trim();

        // Transaction IDs, block hashes and hex are stored lowercase and matched exactly, so pasted uppercase hex would find nothing.
        // Lowercasing is harmless for message search, which ignores case.
        if (query.All(Uri.IsHexDigit))
            query = query.ToLowerInvariant();

        lastQuery = query;

        isTooFewChars = query.Length < 3;
        if (isTooFewChars)
            return;

        _cts?.Dispose();
        _cts = new CancellationTokenSource(SearchTimeout);
        var cancellationToken = _cts.Token;

        isLoading = true;

        try
        {
            string searchQuery = Uri.EscapeDataString(query);

            using var request = new HttpRequestMessage(HttpMethod.Get, $"{Config.BackendUri}/search?query={searchQuery}");
            var httpClient = HttpClientFactory.CreateClient();
            using var response = await httpClient.SendAsync(request, cancellationToken);

            if (!response.IsSuccessStatusCode)
            {
                Logger.Logger.LogWarning($"Search failed. Status: {(int)response.StatusCode} {response.StatusCode}");
                searchError = SearchFailedMessage;
                return;
            }

            searchResult = await response.Content.ReadFromJsonAsync<List<MessageModel>>(cancellationToken) ?? new List<MessageModel>();
        }
        catch (OperationCanceledException)
        {
            // Either the timeout elapsed or the page was closed (Dispose); the message is only seen in the first case.
            Logger.Logger.LogWarning($"Search was cancelled or timed out after {SearchTimeout.TotalSeconds} seconds.");
            searchError = SearchTimedOutMessage;
        }
        catch (Exception ex)
        {
            Logger.Logger.LogCritical(ex);
            searchError = SearchFailedMessage;
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
    }
}